# Hybrid Edge-to-Cloud Speculative Telemetry Router (HESTR)
# Environment Configuration Template

# Google DeepMind Track (Gemini API for gemma-4-31b-it)
GEMINI_API_KEY=your_gemini_api_key_here

# DigitalOcean Track (Serverless Inference for gemma-4-31b-it)
DO_INFERENCE_KEY=your_do_inference_key_here
DO_INFERENCE_ENDPOINT=https://inference.do-ai.run/v1/chat/completions

# Local Edge SLM Runtime (Ollama for gemma4:e4b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Server Configuration
PORT=8088
CLOUD_WS_URL=ws://localhost:8088/ws/telemetry
