  "description": "Hybrid Edge-to-Cloud Speculative Telemetry Router for Hacktoberfest Hack Day New Delhi",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:cloud": "tsx src/cloud/server.ts",
